{
  "name": "company-secretary-management-system",
  "version": "5.2.0",
  "license": "MIT",
  "description": "A modern Company Secretary Management System",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon --ignore .mongo-data --ignore .dev.log server/index.js",
    "client:dev": "cd client && npm run dev",
    "server:start": "node server/index.js",
    "client:build": "cd client && npm run build",
    "start": "node server/index.js",
    "verify:presets": "node server/scripts/verifyPresets.mjs",
    "presets:export": "node server/scripts/exportPresets.mjs",
    "deploy:local": "node scripts/deploy-local.js",
    "setup": "node scripts/run-setup.js",
    "mongo:stop": "node scripts/run-stop-mongo.js",
    "test": "npm run test:client && npm run test:server",
    "test:client": "node client/node_modules/vitest/vitest.mjs run",
    "test:server": "node --test server/tests/*.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1083.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "date-fns": "^3.0.6",
    "docxtemplater": "^3.68.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "mongoose": "^8.0.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "pizzip": "^3.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
