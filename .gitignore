# ===========================================
# Claw - 公司秘书管理系统 .gitignore
# ===========================================

# Dependencies
node_modules/
client/node_modules/

# Local MongoDB data (one-click setup fallback)
.mongo-data/
.mongo-test/

# Build output
dist/
build/
client/dist/
client/build/
# 构建产物备份：为绕过 safe-delete 钩子执行 `mv dist dist_bak` 留下的临时目录
client/dist_bak*/
client/dist-build/
# 前端 mock 预览门禁构建产物（沙箱无法清空 dist-qa，故以 dist-qa* 新目录产出）
client/dist-qa*

# Environment files
.env
.env.local
.env.*.local
.env.production

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov
.nyc_output/

# Uploads (user uploaded files)
uploads/*
!uploads/.gitkeep

# Temp files
temp/
tmp/
*.tmp
*.temp

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE / Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Package manager lock files (可选是否提交)
# package-lock.json
# client/package-lock.json

# Docker volumes
docker-data/

# Backup files
*.bak
*.backup
.backup-*/
output/

# Claude/WorkBuddy specific
.workbuddy/
.claude/

# Test results
test-results/
junit.xml

# Old backup directories
Claw_Company_Secretary_System/
output/
scripts/pdf_extracts/
*.zip

# Vite build temp config files
vite.config.js.timestamp-*
client/vite.config.js.timestamp-*

# 本地调试临时产物（lint/build 输出，勿提交）
/_*.txt
/_*.js

# QA / 调试临时脚本与日志（勿提交）
.qa-*
.final*
.final-out.txt
qa_run*.txt
tmp_*
tmp_*.py
tmp_*.js
_qa_*
# 前端预览/构建实验产物（勿提交）
client/.env.preview
client/dist-build3/
client/dist-polish/
client/dist-rules/
client/dist-snapshot-v1/
client/dist-verify/
client/dist.bak.final/
client/dist_prev_159/
client/dist-qa-r2c/
client/dist-qa-verify/

# Agent 调试探针与缓存（临时验证脚本/输出，勿提交）
.tmp-dump.mjs
bb_out.txt
npmtest_final.txt
smoke_out.txt
srv_final.txt
verify_final.txt
client/dist-t03b/
client/runcheck.mjs
client/signprobe.mjs
client/signprobe.out.txt
client/t03b-lines.txt
client/vcheck.mjs
client/vcheck.out.txt
client/vt.out.txt
client/vtest.out.txt
client/vitest.config.js.timestamp-*.mjs

# 沙箱遗留 MongoDB 回退启动器（未被 deploy-local 引用，沙箱内二进制下载失败）
# 仅 git 忽略；物理删除留待本机 `git clean -fdX`
scripts/start-mongo-memory.js
